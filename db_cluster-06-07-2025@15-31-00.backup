84048059-eb79-4227-bba4-17133a78ddd9	45437649-c00c-4ebc-a9db-64cf06558a7a	eeeceb27-5d08-4673-a297-cad009176183	2025-03-26 10:13:18.088362+00	2025-03-26 12:17:08.638+00	{"skills": {"data": ["Python", "C++", "OOP", "Arduino", "C/C++ for Microcontrollers", "ARM", "RISCV", "RTL", "Verilog", "Github", "Bash", "Linux", "Google Workspace"], "collected": true}, "education": {"data": [{"grade": "3.12", "degree": "Bachelor of Science in Electrical and Electronic Engineering", "institution": "Mymensingh Engineering College", "expected_graduation": "Current", "relevant_coursework": "Electrical Circuits, OOP, Digital Logic Design, Data Structures and Algorithms, Modern Digital Electronics, Electronic Devices and Circuits, Computer Organization and Architecture, Microprocessor and Microcontroller, Artificial Intelligence, Introduction to VLSI Design, Internet of Things"}], "collected": true}, "experience": {"data": [{"title": "President", "company": "Alpha Science Lab BD", "description": "A university club focused on the rising VLSI industry in Bangladesh."}, {"title": "Founder", "company": "oneAPI Community Group Bangladesh", "description": "Dedicated to bringing together enthusiasts and professionals passionate about oneAPI technology."}, {"date": "10/12/2024 – 27/12/2024", "title": "Ranked 3rd - Industrial Training", "company": "Ulkasemi Pvt. Limited", "description": "Successfully fulfilled the requirements to complete the 7 days industrial training on Analog Design, IC Mask Design (Mixed Signal Layout) and IC Physical Design and also secured 3rd place in the industrial training written examination among 4 reputed universities"}], "collected": true}, "resumeHtml": "\\n    \\n    <div style=\\"margin-bottom: 30px;\\">\\n        <h1 style=\\"font-size: 32px; margin: 0; color: #1a0dab;\\">Md. Jannatul Nayem</h1>\\n        <div style=\\"margin-top: 5px;\\">\\n            <span>☎ 01738891140</span> | \\n            <span>✉ j_nayem_2880@mec.edu.bd</span> | \\n            <span> linkedin.com/in/md-jannatul-nayem/</span>\\n        </div>\\n    </div>\\n\\n    \\n    <div style=\\"margin-bottom: 25px;\\">\\n        <h2 style=\\"font-size: 20px; color: #1a0dab; border-bottom: 2px solid #1a0dab; padding-bottom: 5px;\\">SUMMARY</h2>\\n        <p>EEE student with expertise in digital systems design and verification using Verilog and SystemVerilog, with a strong foundation in VLSI design. Interested in RTL/DV positions. Experienced in embedded systems and firmware development for microcontrollers. Enthusiastic about RISC-V and neuromorphic computing for machine learning applications. Enhancing knowledge and industry reach as a Microsoft Learn Student Ambassador and Intel Student Ambassador for OneAPI.</p>\\n    </div>\\n\\n    \\n    <div style=\\"margin-bottom: 25px;\\">\\n        <h2 style=\\"font-size: 20px; color: #1a0dab; border-bottom: 2px solid #1a0dab; padding-bottom: 5px;\\">EDUCATION</h2>\\n        <div style=\\"margin-top: 15px;\\">\\n            <div style=\\"display: flex; justify-content: space-between;\\">\\n                <strong>Bachelor of Science in Electrical and Electronic Engineering</strong>\\n            </div>\\n            <div>Mymensingh Engineering College, Bangladesh</div>\\n            <div>CGPA: 3.12/4.00</div>\\n        </div>\\n    </div>\\n\\n    \\n    <div style=\\"margin-bottom: 25px;\\">\\n        <h2 style=\\"font-size: 20px; color: #1a0dab; border-bottom: 2px solid #1a0dab; padding-bottom: 5px;\\">SKILLS</h2>\\n        <strong>Digital Skills:</strong> Python, C++, OOP, Arduino, C/C++ for Microcontrollers, ARM, RISCV, RTL, Verilog, Github, Bash, Linux, Google Workspace\\n\\n    </div>\\n\\n    \\n    <div style=\\"margin-bottom: 25px;\\">\\n        <h2 style=\\"font-size: 20px; color: #1a0dab; border-bottom: 2px solid #1a0dab; padding-bottom: 5px;\\">EXPERIENCE</h2>\\n\\n        <div style=\\"margin-top: 15px;\\">\\n            <div style=\\"display: flex; justify-content: space-between; margin-bottom: 5px;\\">\\n                <strong>President</strong>\\n            </div>\\n            <div style=\\"margin-bottom: 5px; color: #666;\\">Alpha Science Lab BD, Mymensingh Engineering College</div>\\n            <ul style=\\"margin: 5px 0; padding-left: 20px;\\">\\n                <li>A university club focused on the rising VLSI industry in Bangladesh.</li>\\n            </ul>\\n        </div>\\n\\n        <div style=\\"margin-top: 15px;\\">\\n            <div style=\\"display: flex; justify-content: space-between; margin-bottom: 5px;\\">\\n                <strong>Founder</strong>\\n            </div>\\n            <div style=\\"margin-bottom: 5px; color: #666;\\">oneAPI Community Group Bangladesh</div>\\n            <ul style=\\"margin: 5px 0; padding-left: 20px;\\">\\n                <li>Dedicated to bringing together enthusiasts and professionals passionate about oneAPI technology.</li>\\n            </ul>\\n        </div>\\n\\n        <div style=\\"margin-top: 15px;\\">\\n            <div style=\\"display: flex; justify-content: space-between; margin-bottom: 5px;\\">\\n                <strong>Ranked 3rd - Industrial Training</strong>\\n                <em>10/12/2024 – 27/12/2024</em>\\n            </div>\\n            <div style=\\"margin-bottom: 5px; color: #666;\\">Ulkasemi Pvt. Limited</div>\\n            <ul style=\\"margin: 5px 0; padding-left: 20px;\\">\\n                <li>Successfully completed the 7 days industrial training on Analog Design, IC Mask Design (Mixed Signal Layout) and IC Physical Design and also secured 3rd place in the industrial training written examination among 4 reputed universities</li>\\n            </ul>\\n        </div>\\n    </div>\\n\\n    \\n    <div style=\\"margin-bottom: 25px;\\">\\n        <h2 style=\\"font-size: 20px; color: #1a0dab; border-bottom: 2px solid #1a0dab; padding-bottom: 5px;\\">PROJECTS</h2>\\n\\n        <div style=\\"margin-top: 15px;\\">\\n            <div style=\\"display: flex; justify-content: space-between; margin-bottom: 5px;\\">\\n                <strong>Recon Solar Shield Initiative - RSSI</strong>\\n                <em>13/08/2023 – 08/11/2023</em>\\n            </div>\\n            <ul style=\\"margin: 5px 0; padding-left: 20px;\\">\\n                <li>An advanced web platform for predicting magnetic reconnection occurrences based on DSCOVR and ACE-Satellite data by leveraging artificial intelligence to improve prediction capabilities</li>\\n            </ul>\\n        </div>\\n\\n        <div style=\\"margin-top: 15px;\\">\\n            <div style=\\"display: flex; justify-content: space-between; margin-bottom: 5px;\\">\\n                <strong>PC Health Monitoring and Early Warning System</strong>\\n                <em>21/06/2023 – 11/07/2023</em>\\n            </div>\\n            <ul style=\\"margin: 5px 0; padding-left: 20px;\\">\\n                <li>PC maintenance and environmental monitoring system that elevates the reliability, security, and performance of your computer system</li>\\n            </ul>\\n        </div>\\n\\n        <div style=\\"margin-top: 15px;\\">\\n            <div style=\\"display: flex; justify-content: space-between; margin-bottom: 5px;\\">\\n                <strong>Transmission of IoT Data Over Long Range with LORA</strong>\\n                <em>09/03/2023 – 11/05/2023</em>\\n            </div>\\n            <ul style=\\"margin: 5px 0; padding-left: 20px;\\">\\n                <li>IoT data is typically less in size but requires a wireless technology like LORA to communicate sensor data over a distance and to initiate any activity</li>\\n            </ul>\\n        </div>\\n\\n        <div style=\\"margin-top: 15px;\\">\\n            <div style=\\"display: flex; justify-content: space-between; margin-bottom: 5px;\\">\\n                <strong>Minimalistic Design of Lower Numerical Width ALU</strong>\\n                <em>14/04/2022 – 29/05/2022</em>\\n            </div>\\n            <ul style=\\"margin: 5px 0; padding-left: 20px;\\">\\n                <li>Designed lower numerical width (2 bit/4 bit/8 bit) arithmetic and logic unit with minimal instruction set using 74 series ICs to understand the working of processors</li>\\n            </ul>\\n        </div>\\n    </div>\\n\\n    \\n    <div style=\\"margin-bottom: 25px;\\">\\n        <h2 style=\\"font-size: 20px; color: #1a0dab; border-bottom: 2px solid #1a0dab; padding-bottom: 5px;\\">CERTIFICATIONS</h2>\\n        <ul>\\n            <li>RISC-V Processor - RV32I Base ISA - Maven Silicon</li>\\n            <li>Python Essentials 2 - Coding in Python 3 - Cisco Networking Academy</li>\\n            <li>8086, 80386 and P5 Microarchitecture - Bharat Acharya Education</li>\\n        </ul>\\n    </div>\\n\\n    \\n    <div style=\\"margin-bottom: 25px;\\">\\n        <h2 style=\\"font-size: 20px; color: #1a0dab; border-bottom: 2px solid #1a0dab; padding-bottom: 5px;\\">VOLUNTEERING</h2>\\n\\n        <div style=\\"margin-top: 15px;\\">\\n            <div style=\\"display: flex; justify-content: space-between; margin-bottom: 5px;\\">\\n                <strong>Intel ® Student Ambassador for oneAPI</strong>\\n                <em>14/02/2024 – Current</em>\\n            </div>\\n            <ul style=\\"margin: 5px 0; padding-left: 20px;\\">\\n                <li>Promote and support Intel technology specifically oneAPI industry initiative on campus</li>\\n            </ul>\\n        </div>\\n\\n        <div style=\\"margin-top: 15px;\\">\\n            <div style=\\"display: flex; justify-content: space-between; margin-bottom: 5px;\\">\\n                <strong>Microsoft Learn Student Ambassador</strong>\\n                <em>24/01/2024 – Current</em>\\n            </div>\\n            <ul style=\\"margin: 5px 0; padding-left: 20px;\\">\\n                <li>Making contributions to the collaborative atmosphere fostered by the MLSA program. Beta milestones unlocked.</li>\\n            </ul>\\n        </div>\\n\\n        <div style=\\"margin-top: 15px;\\">\\n            <div style=\\"display: flex; justify-content: space-between; margin-bottom: 5px;\\">\\n                <strong>Ulkasemi Campus Ambassador for MEC</strong>\\n                <em>28/02/2025 – Current</em>\\n            </div>\\n            <ul style=\\"margin: 5px 0; padding-left: 20px;\\">\\n                <li>Contribute to the overall VLSI landscape of Bangladesh by representing Ulkasemi as a semiconductor design company on campus</li>\\n            </ul>\\n        </div>\\n    </div>\\n\\n    \\n    <div style=\\"margin-bottom: 25px;\\">\\n        <h2 style=\\"font-size: 20px; color: #1a0dab; border-bottom: 2px solid #1a0dab; padding-bottom: 5px;\\">HONORS &amp; AWARDS</h2>\\n\\n        <div style=\\"margin-top: 15px;\\">\\n            <div style=\\"display: flex; justify-content: space-between; margin-bottom: 5px;\\">\\n                <strong>Winner - RISCV Video Contest</strong>\\n                <em>01/05/2024 - RISCV International</em>\\n            </div>\\n            <ul style=\\"margin: 5px 0; padding-left: 20px;\\">\\n                <li>Prepared a video highlighting the uniqueness, benefits and opportunities that come along with RISCV</li>\\n            </ul>\\n        </div>\\n\\n        <div style=\\"margin-top: 15px;\\n            &lt;div style=\\">\\n                <strong>Champion - Walton Laptop 3rd National Science Fair</strong>\\n                <em>24/11/2023 - Walton Laptop</em>\\n            </div>\\n            <ul style=\\"margin: 5px 0; padding-left: 20px;\\">\\n                <li>Developed an IoT based vertically stacked farming system in indoor spaces for urban areas</li>\\n            </ul>\\n        </div>\\n\\n        <div style=\\"margin-top: 15px;\\">\\n            <div style=\\"display: flex; justify-content: space-between; margin-bottom: 5px;\\">\\n                <strong>1st Runner Up - Space Apps Challenge 2023</strong>\\n                <em>08/10/2023 - BASIS</em>\\n            </div>\\n            <ul style=\\"margin: 5px 0; padding-left: 20px;\\">\\n                <li>Secured 1st Runner up position from Mymensingh region led by me for the project Recon Solar Shield Initiative- RSSI</li>\\n            </ul>\\n        </div>\\n    \\n", "personalInfo": {"data": {"name": "Md. Jannatul Nayem", "email": "j_nayem_2880@mec.edu.bd", "phone": "01738891140", "linkedin": "https://www.linkedin.com/in/md-jannatul-nayem/"}, "collected": true}}	inactive	\n    \n    <div style="margin-bottom: 30px;">\n        <h1 style="font-size: 32px; margin: 0; color: #1a0dab;">Md. Jannatul Nayem</h1>\n        <div style="margin-top: 5px;">\n            <span>☎ 01738891140</span> | \n            <span>✉ j_nayem_2880@mec.edu.bd</span> | \n            <span> linkedin.com/in/md-jannatul-nayem/</span>\n        </div>\n    </div>\n\n    \n    <div style="margin-bottom: 25px;">\n        <h2 style="font-size: 20px; color: #1a0dab; border-bottom: 2px solid #1a0dab; padding-bottom: 5px;">SUMMARY</h2>\n        <p>EEE student with expertise in digital systems design and verification using Verilog and SystemVerilog, with a strong foundation in VLSI design. Interested in RTL/DV positions. Experienced in embedded systems and firmware development for microcontrollers. Enthusiastic about RISC-V and neuromorphic computing for machine learning applications. Enhancing knowledge and industry reach as a Microsoft Learn Student Ambassador and Intel Student Ambassador for OneAPI.</p>\n    </div>\n\n    \n    <div style="margin-bottom: 25px;">\n        <h2 style="font-size: 20px; color: #1a0dab; border-bottom: 2px solid #1a0dab; padding-bottom: 5px;">EDUCATION</h2>\n        <div style="margin-top: 15px;">\n            <div style="display: flex; justify-content: space-between;">\n                <strong>Bachelor of Science in Electrical and Electronic Engineering</strong>\n            </div>\n            <div>Mymensingh Engineering College, Bangladesh</div>\n            <div>CGPA: 3.12/4.00</div>\n        </div>\n    </div>\n\n    \n    <div style="margin-bottom: 25px;">\n        <h2 style="font-size: 20px; color: #1a0dab; border-bottom: 2px solid #1a0dab; padding-bottom: 5px;">SKILLS</h2>\n        <strong>Digital Skills:</strong> Python, C++, OOP, Arduino, C/C++ for Microcontrollers, ARM, RISCV, RTL, Verilog, Github, Bash, Linux, Google Workspace\n\n    </div>\n\n    \n    <div style="margin-bottom: 25px;">\n        <h2 style="font-size: 20px; color: #1a0dab; border-bottom: 2px solid #1a0dab; padding-bottom: 5px;">EXPERIENCE</h2>\n\n        <div style="margin-top: 15px;">\n            <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">\n                <strong>President</strong>\n            </div>\n            <div style="margin-bottom: 5px; color: #666;">Alpha Science Lab BD, Mymensingh Engineering College</div>\n            <ul style="margin: 5px 0; padding-left: 20px;">\n                <li>A university club focused on the rising VLSI industry in Bangladesh.</li>\n            </ul>\n        </div>\n\n        <div style="margin-top: 15px;">\n            <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">\n                <strong>Founder</strong>\n            </div>\n            <div style="margin-bottom: 5px; color: #666;">oneAPI Community Group Bangladesh</div>\n            <ul style="margin: 5px 0; padding-left: 20px;">\n                <li>Dedicated to bringing together enthusiasts and professionals passionate about oneAPI technology.</li>\n            </ul>\n        </div>\n\n        <div style="margin-top: 15px;">\n            <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">\n                <strong>Ranked 3rd - Industrial Training</strong>\n                <em>10/12/2024 – 27/12/2024</em>\n            </div>\n            <div style="margin-bottom: 5px; color: #666;">Ulkasemi Pvt. Limited</div>\n            <ul style="margin: 5px 0; padding-left: 20px;">\n                <li>Successfully completed the 7 days industrial training on Analog Design, IC Mask Design (Mixed Signal Layout) and IC Physical Design and also secured 3rd place in the industrial training written examination among 4 reputed universities</li>\n            </ul>\n        </div>\n    </div>\n\n    \n    <div style="margin-bottom: 25px;">\n        <h2 style="font-size: 20px; color: #1a0dab; border-bottom: 2px solid #1a0dab; padding-bottom: 5px;">PROJECTS</h2>\n\n        <div style="margin-top: 15px;">\n            <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">\n                <strong>Recon Solar Shield Initiative - RSSI</strong>\n                <em>13/08/2023 – 08/11/2023</em>\n            </div>\n            <ul style="margin: 5px 0; padding-left: 20px;">\n                <li>An advanced web platform for predicting magnetic reconnection occurrences based on DSCOVR and ACE-Satellite data by leveraging artificial intelligence to improve prediction capabilities</li>\n            </ul>\n        </div>\n\n        <div style="margin-top: 15px;">\n            <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">\n                <strong>PC Health Monitoring and Early Warning System</strong>\n                <em>21/06/2023 – 11/07/2023</em>\n            </div>\n            <ul style="margin: 5px 0; padding-left: 20px;">\n                <li>PC maintenance and environmental monitoring system that elevates the reliability, security, and performance of your computer system</li>\n            </ul>\n        </div>\n\n        <div style="margin-top: 15px;">\n            <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">\n                <strong>Transmission of IoT Data Over Long Range with LORA</strong>\n                <em>09/03/2023 – 11/05/2023</em>\n            </div>\n            <ul style="margin: 5px 0; padding-left: 20px;">\n                <li>IoT data is typically less in size but requires a wireless technology like LORA to communicate sensor data over a distance and to initiate any activity</li>\n            </ul>\n        </div>\n\n        <div style="margin-top: 15px;">\n            <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">\n                <strong>Minimalistic Design of Lower Numerical Width ALU</strong>\n                <em>14/04/2022 – 29/05/2022</em>\n            </div>\n            <ul style="margin: 5px 0; padding-left: 20px;">\n                <li>Designed lower numerical width (2 bit/4 bit/8 bit) arithmetic and logic unit with minimal instruction set using 74 series ICs to understand the working of processors</li>\n            </ul>\n        </div>\n    </div>\n\n    \n    <div style="margin-bottom: 25px;">\n        <h2 style="font-size: 20px; color: #1a0dab; border-bottom: 2px solid #1a0dab; padding-bottom: 5px;">CERTIFICATIONS</h2>\n        <ul>\n            <li>RISC-V Processor - RV32I Base ISA - Maven Silicon</li>\n            <li>Python Essentials 2 - Coding in Python 3 - Cisco Networking Academy</li>\n            <li>8086, 80386 and P5 Microarchitecture - Bharat Acharya Education</li>\n        </ul>\n    </div>\n\n    \n    <div style="margin-bottom: 25px;">\n        <h2 style="font-size: 20px; color: #1a0dab; border-bottom: 2px solid #1a0dab; padding-bottom: 5px;">VOLUNTEERING</h2>\n\n        <div style="margin-top: 15px;">\n            <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">\n                <strong>Intel ® Student Ambassador for oneAPI</strong>\n                <em>14/02/2024 – Current</em>\n            </div>\n            <ul style="margin: 5px 0; padding-left: 20px;">\n                <li>Promote and support Intel technology specifically oneAPI industry initiative on campus</li>\n            </ul>\n        </div>\n\n        <div style="margin-top: 15px;">\n            <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">\n                <strong>Microsoft Learn Student Ambassador</strong>\n                <em>24/01/2024 – Current</em>\n            </div>\n            <ul style="margin: 5px 0; padding-left: 20px;">\n                <li>Making contributions to the collaborative atmosphere fostered by the MLSA program. Beta milestones unlocked.</li>\n            </ul>\n        </div>\n\n        <div style="margin-top: 15px;">\n            <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">\n                <strong>Ulkasemi Campus Ambassador for MEC</strong>\n                <em>28/02/2025 – Current</em>\n            </div>\n            <ul style="margin: 5px 0; padding-left: 20px;">\n                <li>Contribute to the overall VLSI landscape of Bangladesh by representing Ulkasemi as a semiconductor design company on campus</li>\n            </ul>\n        </div>\n    </div>\n\n    \n    <div style="margin-bottom: 25px;">\n        <h2 style="font-size: 20px; color: #1a0dab; border-bottom: 2px solid #1a0dab; padding-bottom: 5px;">HONORS &amp; AWARDS</h2>\n\n        <div style="margin-top: 15px;">\n            <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">\n                <strong>Winner - RISCV Video Contest</strong>\n                <em>01/05/2024 - RISCV International</em>\n            </div>\n            <ul style="margin: 5px 0; padding-left: 20px;">\n                <li>Prepared a video highlighting the uniqueness, benefits and opportunities that come along with RISCV</li>\n            </ul>\n        </div>\n\n        <div style="margin-top: 15px;\n            &lt;div style=">\n                <strong>Champion - Walton Laptop 3rd National Science Fair</strong>\n                <em>24/11/2023 - Walton Laptop</em>\n            </div>\n            <ul style="margin: 5px 0; padding-left: 20px;">\n                <li>Developed an IoT based vertically stacked farming system in indoor spaces for urban areas</li>\n            </ul>\n        </div>\n\n        <div style="margin-top: 15px;">\n            <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">\n                <strong>1st Runner Up - Space Apps Challenge 2023</strong>\n                <em>08/10/2023 - BASIS</em>\n            </div>\n            <ul style="margin: 5px 0; padding-left: 20px;">\n                <li>Secured 1st Runner up position from Mymensingh region led by me for the project Recon Solar Shield Initiative- RSSI</li>\n            </ul>\n        </div>\n    \n	\N	\N
