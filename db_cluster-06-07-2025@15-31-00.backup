0201c51a-2621-466e-b412-096744567671	45437649-c00c-4ebc-a9db-64cf06558a7a	session_45437649-c00c-4ebc-a9db-64cf06558a7a_1742575250421	2025-03-21 16:40:50.300382+00	2025-04-02 06:10:10.854+00	{"skills": {"data": ["Social Development", "Communication", "Community Outreach"], "collected": true}, "education": {"data": [{"major": "Computer Science and Engineering", "degree": "Bachelor of Science", "end_date": "November 2026", "start_date": "November 2021", "institution": "Mymensingh Engineering College"}, {"major": "Science", "degree": "HSC", "end_date": "January 2021", "start_date": "July 2019", "institution": "RAJUK Uttara Model College"}], "collected": true}, "experience": {"data": [{"title": "Co-Founder", "company": "Flan BD", "end_date": "Present", "location": "Mymensingh Sadar Upazila, Bangladesh", "start_date": "January 2025", "description": "Online gift shop based in Mymensingh."}], "collected": true}, "resumeHtml": "<div style=\\"font-family: Arial, sans-serif; max-width: 800px; margin: 40px auto; padding: 30px; border: 1px solid #ddd; border-radius: 12px; background-color: #fafafa; box-shadow: 0 4px 10px rgba(0,0,0,0.1); color: #333; line-height: 1.6;\\">\\n    \\n    <div style=\\"text-align: center; margin-bottom: 20px;\\">\\n        <h1 style=\\"margin-bottom: 5px; font-size: 32px; color: #222;\\">C.M. Mahim Masrafi</h1>\\n        <p style=\\"font-size: 16px; color: #555;\\">Full Stack Developer | Vibe Coding | CSE Undergrad at MEC<br>\\n            Dhaka, Dhaka, Bangladesh<br>\\n            <a style=\\"color: #0066cc; text-decoration: none;\\" href=\\"tel:01912244011\\">01912244011</a> |\\n            <a style=\\"color: #0066cc; text-decoration: none;\\" href=\\"mailto:mahimmasrafi111@gmail.com\\">mahimmasrafi111@gmail.com</a> |\\n            <a style=\\"color: #0066cc; text-decoration: none;\\" href=\\"www.linkedin.com/in/c-m-mahimmasrafi-84b623223\\">LinkedIn</a>\\n        </p>\\n    </div>\\n\\n    \\n    <h2 style=\\"font-size: 22px; color: #0066cc; border-bottom: 2px solid #eee; padding-bottom: 8px;\\">Summary</h2>\\n    <p>\\n        Full stack developer with enriched knowledge of AI integration and a strong foundation in mobile app development. Experienced in React Native and proficient in building cross-platform applications. Seeking to leverage expertise to optimize application performance, enhance UI/UX, and contribute to innovative projects at Daniyal Technologies.\\n    </p>\\n\\n    \\n    <h2 style=\\"font-size: 22px; color: #0066cc; border-bottom: 2px solid #eee; padding-bottom: 8px;\\">Top Skills</h2>\\n    <p>\\n        React Native, Flutter (Good to have), Mobile App Architecture (MVVM, Clean Architecture), RESTful API Integration, Database Management (RDBMS, NoSQL), Performance Optimization, Debugging, NextJs, NestJs\\n    </p>\\n\\n    \\n    <h2 style=\\"font-size: 22px; color: #0066cc; border-bottom: 2px solid #eee; padding-bottom: 8px;\\">Experience</h2>\\n    <div style=\\"margin-bottom: 20px;\\">\\n        <strong>Co-Founder</strong>, Flan BD<br>\\n        January 2025 - Present (4 months)<br>\\n        Mymensingh Sadar Upazila, Bangladesh<br>\\n        <p>Online gift shop based in Mymensingh.</p>\\n    </div>\\n    \\n    \\n    <h2 style=\\"font-size: 22px; color: #0066cc; border-bottom: 2px solid #eee; padding-bottom: 8px;\\">Projects</h2>\\n    \\n    <div style=\\"margin-bottom: 20px; padding: 16px; border-left: 4px solid #0066cc; background-color: #f9f9f9; border-radius: 8px;\\">\\n        <strong style=\\"font-size: 18px;\\">ResumeGuru - AI-Powered Resume Builder</strong>\\n        <p>A modern resume builder leveraging AI to transform the career journey. Built with React and TypeScript, featuring professional templates and ATS-optimized content.</p>\\n        <ul style=\\"margin-left: 20px; padding-left: 0;\\">\\n            <li>Led development of front-end and back-end integration.</li>\\n            <li>Tech Stack: React, TypeScript, Tailwind CSS, Supabase, React Query, Framer Motion</li>\\n            <li>Built a secure and user-friendly platform with real-time and multi-format export.</li>\\n        </ul>\\n    </div>\\n\\n    <div style=\\"margin-bottom: 20px; padding: 16px; border-left: 4px solid #0066cc; background-color: #f9f9f9; border-radius: 8px;\\">\\n        <strong style=\\"font-size: 18px;\\">UPP Campus - Modern Campus Social Platform</strong>\\n        <p>A social platform for university students to connect and share updates. Includes real-time updates and secure authentication.</p>\\n        <ul style=\\"margin-left: 20px; padding-left: 0;\\">\\n            <li>Developed a seamless user experience with responsive design.</li>\\n            <li>Tech Stack: React, TypeScript, Supabase, Framer Motion</li>\\n            <li>Created a feature-rich platform with real-time notifications and user profiles.</li>\\n        </ul>\\n    </div>\\n\\n    <div style=\\"margin-bottom: 20px; padding: 16px; border-left: 4px solid #0066cc; background-color: #f9f9f9; border-radius: 8px;\\">\\n        <strong style=\\"font-size: 18px;\\">FaceFusion - Advanced Facial Recognition System</strong>\\n        <p>A sophisticated web app using machine learning for real-time facial recognition and emotion analysis.</p>\\n        <ul style=\\"margin-left: 20px; padding-left: 0;\\">\\n            <li>Integrated TensorFlow.js for real-time face detection and emotion analysis.</li>\\n            <li>Tech Stack: Node.js, TensorFlow.js, Face-API.js</li>\\n            <li>Engineered secure biometric authentication with anti-spoofing measures.</li>\\n        </ul>\\n    </div>\\n\\n    <div style=\\"margin-bottom: 20px; padding: 16px; border-left: 4px solid #0066cc; background-color: #f9f9f9; border-radius: 8px;\\">\\n        <strong style=\\"font-size: 18px;\\">Life on Titan - Interactive Educational Web App</strong>\\n        <p>An educational app exploring the potential for life on Titan, with engaging visuals and AI-generated content.</p>\\n        <ul style=\\"margin-left: 20px; padding-left: 0;\\">\\n            <li>Created interactive 3D models using Three.js.</li>\\n            <li>Tech Stack: React, Three.js, GSAP</li>\\n            <li>Enhanced learning experience with AI-driven narration and simulations.</li>\\n        </ul>\\n    </div>\\n\\n    \\n    <h2 style=\\"font-size: 22px; color: #0066cc; border-bottom: 2px solid #eee; padding-bottom: 8px;\\">Education</h2>\\n    <div style=\\"margin-bottom: 20px;\\">\\n        <strong>Bachelor of Science in Computer Science and Engineering</strong>, Mymensingh Engineering College<br>\\n        November 2021 - November 2026\\n    </div>\\n\\n    <div style=\\"margin-bottom: 20px;\\">\\n        <strong>HSC, Science</strong>, RAJUK Uttara Model College<br>\\n        July 2019 - January 2021\\n    </div>\\n</div>", "personalInfo": {"data": {"name": "C.M. Mahim Masrafi", "email": "mahimmasrafi111@gmail.com", "phone": "01912244011", "title": "Full Stack Developer", "linkedin": "www.linkedin.com/in/c-m-mahimmasrafi-84b623223", "location": "Dhaka, Dhaka, Bangladesh"}, "collected": true}}	inactive	<div style="font-family: Arial, sans-serif; max-width: 800px; margin: 40px auto; padding: 30px; border: 1px solid #ddd; border-radius: 12px; background-color: #fafafa; box-shadow: 0 4px 10px rgba(0,0,0,0.1); color: #333; line-height: 1.6;">\n    \n    <div style="text-align: center; margin-bottom: 20px;">\n        <h1 style="margin-bottom: 5px; font-size: 32px; color: #222;">C.M. Mahim Masrafi</h1>\n        <p style="font-size: 16px; color: #555;">Full Stack Developer | Vibe Coding | CSE Undergrad at MEC<br>\n            Dhaka, Dhaka, Bangladesh<br>\n            <a style="color: #0066cc; text-decoration: none;" href="tel:01912244011">01912244011</a> |\n            <a style="color: #0066cc; text-decoration: none;" href="mailto:mahimmasrafi111@gmail.com">mahimmasrafi111@gmail.com</a> |\n            <a style="color: #0066cc; text-decoration: none;" href="www.linkedin.com/in/c-m-mahimmasrafi-84